{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<div
  id="WishlistModal"
  class="wishlist-modal"
  data-wishlist-modal
  data-money-format="{{ shop.money_format | escape }}"
  hidden
>
  <button class="wishlist-modal__backdrop" type="button" aria-label="Close wishlist" data-wishlist-close></button>
  <div
    class="wishlist-modal__dialog color-{{ settings.card_color_scheme }} gradient"
    role="dialog"
    aria-modal="true"
    aria-labelledby="WishlistModalTitle"
  >
    <div class="wishlist-modal__header">
      <h2 id="WishlistModalTitle" class="wishlist-modal__title h2">Wishlist</h2>
      <button type="button" class="wishlist-modal__close" aria-label="Close wishlist" data-wishlist-close>
        <span class="svg-wrapper">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </span>
      </button>
    </div>
    <div class="wishlist-modal__body">
      <p class="wishlist-modal__empty" data-wishlist-empty>
        Your wishlist is empty.
      </p>
      <ul class="grid grid--2-col-tablet-down grid--4-col-desktop wishlist-modal__grid" role="list" data-wishlist-items>
      </ul>
    </div>
  </div>
</div>
