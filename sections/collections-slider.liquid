{{ 'section-collection-list.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #CollectionsSlider-{{ section.id }} .collections-slider__buttons {
    display: none;
  }

  @media screen and (max-width: 989px) {
    #CollectionsSlider-{{ section.id }}.collections-slider--mobile-enabled .collections-slider__buttons {
      display: flex !important;
    }
  }

  @media screen and (min-width: 990px) {
    #CollectionsSlider-{{ section.id }}.collections-slider--desktop-enabled .collections-slider__buttons {
      display: flex !important;
    }
  }

  #CollectionsSlider-{{ section.id }} .collection-list__item {
    display: flex;
    justify-content: center;
  }

  #CollectionsSlider-{{ section.id }} .collection-list__item .card-wrapper {
    width: 100%;
    max-width: 22rem;
  }

  @media screen and (max-width: 749px) {
    #CollectionsSlider-{{ section.id }} .collection-list__item .card-wrapper {
      max-width: 16rem;
    }
  }
{%- endstyle -%}

{%- liquid
  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign columns_desktop_int = section.settings.columns_desktop | plus: 0

  assign show_mobile_slider = false
  if section.settings.enable_mobile_slider and section.blocks.size > columns_mobile_int
    assign show_mobile_slider = true
  endif

  assign show_desktop_slider = false
  if section.settings.enable_desktop_slider and section.blocks.size > columns_desktop_int
    assign show_desktop_slider = true
  endif

  assign slider_enabled = false
  if show_mobile_slider or show_desktop_slider
    assign slider_enabled = true
  endif
-%}

<div
  id="CollectionsSlider-{{ section.id }}"
  class="collections-slider color-{{ section.settings.color_scheme }} gradient{% if show_mobile_slider %} collections-slider--mobile-enabled{% endif %}{% if show_desktop_slider %} collections-slider--desktop-enabled{% endif %}"
>
  <div class="collection-list-wrapper page-width isolate{% if slider_enabled %} page-width-desktop{% endif %}{% if section.settings.title == blank %} no-heading{% endif %} section-{{ section.id }}-padding">
    {%- unless section.settings.title == blank -%}
      <div class="title-wrapper-with-link{% if slider_enabled %} title-wrapper--self-padded-tablet-down{% else %} title-wrapper--self-padded-mobile{% endif %} title-wrapper--no-top-margin">
        <h2 class="collection-list-title inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </h2>
      </div>
    {%- endunless -%}

    <slider-component class="slider-mobile-gutter">
      <ul
        id="Slider-Collections-{{ section.id }}"
        class="collections-slider__track collection-list contains-card contains-card--collection{% if settings.card_style == 'standard' %} contains-card--standard{% endif %} grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down{% if slider_enabled %} slider{% endif %}{% if show_mobile_slider %} slider--tablet grid--peek{% endif %}{% if show_desktop_slider %} slider--desktop{% endif %} collection-list--{{ section.blocks.size }}-items"
        role="list"
      >
        {%- liquid
          assign columns = section.blocks.size
          if columns > 3
            assign columns = 3
          endif
        -%}

        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <li
              id="Slide-Collections-{{ section.id }}-{{ forloop.index }}"
              class="collection-list__item grid__item{% if slider_enabled %} slider__slide{% endif %}{% if block.settings.collection.featured_image == nil %} collection-list__item--no-media{% endif %}"
              {{ block.shopify_attributes }}
            >
              {%- assign placeholder_image_index = forloop.index0 | modulo: 4 | plus: 1 -%}
              {%- assign placeholder_image = 'collection-apparel-' | append: placeholder_image_index -%}
              {% render 'card-collection',
                card_collection: block.settings.collection,
                media_aspect_ratio: section.settings.image_ratio,
                columns: columns,
                placeholder_image: placeholder_image
              %}
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..3) -%}
            <li
              id="Slide-Collections-{{ section.id }}-{{ forloop.index }}"
              class="collection-list__item grid__item{% if slider_enabled %} slider__slide{% endif %}"
            >
              {%- assign placeholder_image = 'collection-apparel-' | append: forloop.index -%}
              {% render 'card-collection',
                media_aspect_ratio: section.settings.image_ratio,
                columns: columns_desktop_int,
                placeholder_image: placeholder_image
              %}
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>

      {%- if slider_enabled -%}
        <div class="slider-buttons collections-slider__buttons">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
            aria-controls="Slider-Collections-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ section.blocks.size }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
            aria-controls="Slider-Collections-{{ section.id }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
      {%- endif -%}
    </slider-component>

  </div>
</div>

{% schema %}
{
  "name": "Collections slider",
  "tag": "section",
  "class": "section section-collection-list",
  "max_blocks": 12,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Shop collections",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "square",
      "label": "Image ratio"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Desktop columns"
    },
    {
      "type": "checkbox",
      "id": "enable_desktop_slider",
      "default": true,
      "label": "Enable desktop slider"
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "2",
      "label": "Mobile columns"
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_slider",
      "default": true,
      "label": "Enable mobile slider"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "collection_item",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections slider",
      "blocks": [
        {
          "type": "collection_item"
        },
        {
          "type": "collection_item"
        },
        {
          "type": "collection_item"
        }
      ]
    }
  ]
}
{% endschema %}
